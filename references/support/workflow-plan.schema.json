{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_name", "brief", "aspect_ratio", "fps", "screenplay", "shooting_script", "shots"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project_name": {"type": "string", "minLength": 1},
    "brief": {"type": "string", "minLength": 1},
    "aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]{0,3}:[1-9][0-9]{0,3}$"},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "screenplay": {"type": "string", "minLength": 1},
    "shooting_script": {"type": "string", "minLength": 1},
    "shots": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "duration_seconds", "purpose", "start_state", "end_state", "image_prompt", "video_prompt", "reference_assets"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
          "purpose": {"type": "string", "minLength": 1},
          "start_state": {"type": "string", "minLength": 1},
          "end_state": {"type": "string", "minLength": 1},
          "image_prompt": {"type": "string", "minLength": 1},
          "video_prompt": {"type": "string", "minLength": 1},
          "reference_assets": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["path", "role"],
              "properties": {"path": {"type": "string"}, "role": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
