  "script": {
    "screenplay": "候车室，夜。门在画左。林泽坐画左，周宁坐画右。\n林泽右手握着没有姓名的信封：还寄吗？\n周宁看空白封面，伸手又停住。\n周宁：不写名字？\n林泽：你会认得。\n他把信推过桌面。周宁用右手接住，两人仍坐原位。",
    "shooting_script": "40秒，16:9、24fps。四镜各10秒；按B01到B04完成问、看、追问、交付。固定门与人物空间轴，信封全程右手持有。台词按逐句原文，不加旁白、字幕、背景音乐。站内底声跨镜与纸面摩擦声仅作后期cue计划，尚无真实素材，不授权生成或自动混音。",
    "beats": [
      {
        "id": "B01",
        "scene_id": "SC01",
        "action": "林泽把无姓名的信封握在右手，问是否还寄。",
        "cause": "列车广播已经停下，两人必须决定。",
        "effect": "周宁注意到信封没有姓名。",
        "dialogue": [
          {
            "id": "L01",
            "speaker": "林泽",
            "text": "还寄吗？"
          }
        ]
      },
      {
        "id": "B02",
        "scene_id": "SC01",
        "action": "周宁先看空白信封，再抬眼看林泽。",
        "cause": "林泽的问题使她看向信封。",
        "effect": "她发现没有写姓名，停住伸向信封的手。",
        "dialogue": []
      },
      {
        "id": "B03",
        "scene_id": "SC01",
        "action": "周宁没有接信，问出姓名缺失。",
        "cause": "信封空白让交付变得不确定。",
        "effect": "林泽决定把问题交还给她。",
        "dialogue": [
          {
            "id": "L02",
            "speaker": "周宁",
            "text": "不写名字？"
          }
        ]
      },
      {
        "id": "B04",
        "scene_id": "SC01",
        "action": "林泽回答后把信封推过桌面，周宁以右手接住。",
        "cause": "周宁等待明确答复。",
        "effect": "信封由林泽交到周宁，交付完成。",
        "dialogue": [
          {
            "id": "L03",
            "speaker": "林泽",
            "text": "你会认得。"
          }
        ]
      }
    ]
  },
